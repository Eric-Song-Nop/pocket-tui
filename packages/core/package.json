{
  "name": "@pocket-tui/core",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "native", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "bun run --cwd ../.. build:native && bun run build",
    "pack:check": "bun pm pack --dry-run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.2"
  }
}
