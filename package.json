{
  "name": "@pocket-tui/workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "check": "cargo check --workspace && bun run typecheck",
    "typecheck": "tsc --noEmit",
    "build:native": "cargo build -p pocket-tui-napi --release",
    "build": "bun run build:native && bun run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.2"
  }
}

