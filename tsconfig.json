{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@pocket-tui/core": ["packages/core/src/index.ts"],
      "@pocket-tui/pocketjs": ["packages/pocketjs/src/index.ts"]
    },
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["packages/**/*.ts", "examples/**/*.ts"]
}
